# Copy to .env (repo root or backend/). Every variable is optional; defaults are shown.
# Paths may be absolute or relative to the directory uvicorn is started from (backend/ with start.bat).

# ---- Storage
# CODEGUARD_DATABASE_URL=sqlite:///./data/codeguard.db
# CODEGUARD_ARTIFACTS_DIR=./ml/artifacts
# CODEGUARD_FRONTEND_DIST=../frontend/dist

# ---- Server
CODEGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CODEGUARD_LOG_LEVEL=INFO
CODEGUARD_JOB_WORKERS=2
CODEGUARD_RATE_LIMIT_PER_MINUTE=120
CODEGUARD_MAX_FILE_BYTES=500000
CODEGUARD_MAX_BATCH_FILES=100
CODEGUARD_MAX_REQUEST_BYTES=25000000

# ---- Plagiarism engine
CODEGUARD_WINNOW_K=8
CODEGUARD_WINNOW_W=5
CODEGUARD_AST_MIN_SUBTREE=6
CODEGUARD_PLAGIARISM_THRESHOLD=0.5

# ---- AI detector ensemble
CODEGUARD_ENABLE_HEURISTIC=true
CODEGUARD_AI_WEIGHT_XGB=0.4
CODEGUARD_AI_WEIGHT_CODEBERT=0.6
CODEGUARD_AI_WEIGHT_HEURISTIC=0.2
CODEGUARD_ENABLE_CODEBERT=true
CODEGUARD_ENABLE_VULN_MODEL=true

# ---- Dataset generation only (ml/build_dataset.py)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
