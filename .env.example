# ---- Backend (all optional; defaults shown) ----
CODEGUARD_DATABASE_URL=sqlite:///./backend/data/codeguard.db
CODEGUARD_ARTIFACTS_DIR=./backend/ml/artifacts
CODEGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CODEGUARD_MAX_FILE_BYTES=500000
CODEGUARD_MAX_BATCH_FILES=100
CODEGUARD_JOB_WORKERS=2
CODEGUARD_WINNOW_K=8
CODEGUARD_WINNOW_W=5
CODEGUARD_AST_MIN_SUBTREE=6
CODEGUARD_PLAGIARISM_THRESHOLD=0.5
CODEGUARD_ENABLE_CODEBERT=true
CODEGUARD_ENABLE_VULN_MODEL=true

# ---- Dataset generation only (ml/build_dataset.py) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
